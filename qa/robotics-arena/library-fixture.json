D6. Sensor: TRIG=D9, ECHO=D10.\nlong distanciaCm() {\n  digitalWrite(9, LOW); delayMicroseconds(2); digitalWrite(9, HIGH); delayMicroseconds(10); digitalWrite(9, LOW);\n  unsigned long us = pulseIn(10, HIGH, 25000UL);\n  if (us == 0) return 400;\n  return us / 58;\n}\nvoid motores(bool izqAdelante, bool derAdelante, int fuerza) {\n  digitalWrite(4, izqAdelante); digitalWrite(7, !izqAdelante);\n  digitalWrite(8, derAdelante); digitalWrite(12, !derAdelante);\n  analogWrite(5, fuerza); analogWrite(6, fuerza);\n}\nvoid setup() { pinMode(4, OUTPUT); pinMode(7, OUTPUT); pinMode(8, OUTPUT); pinMode(12, OUTPUT); pinMode(9, OUTPUT); pinMode(10, INPUT); }\nvoid loop() {\n  if (distanciaCm() < 20) { motores(true, false, 200); delay(400); }\n  else motores(true, true, 200);\n  delay(30);\n}\n","updatedAt":"2026-10-30T17:31:04.392Z","artifact":{"hex":":100000000C945C000C946E000C946E000C946E00CA\r\n:100010000C946E000C946E000C946E000C946E00A8\r\n:100020000C946E000C946E000C946E000C946E0098\r\n:100030000C946E000C946E000C946E000C946E0088\r\n:100040000C9426010C946E000C946E000C946E00BF\r\n:100050000C946E000C946E000C946E000C946E0068\r\n:100060000C946E000C946E00000000002500280027\r\n:100070002B0000000000240027002A0004040404D0\r\n:100080000404040402020202020203030303030342\r\n:10009000010204081020408001020408102001021F\r\n:1000A00004081020000000080002010000030407FB\r\n:1000B000000000000000000011241FBECFEFD8E0B8\r\n:1000C000DEBFCDBF21E0A0E0B1E001C01D92A930AC\r\n:1000D000B207E1F70E9470010C94E2010C94000059\r\n:1000E00090E0FC01E057FF4F249184589F4FFC01A2\r\n:1000F0008491882399F090E0880F991FFC01EE58B5\r\n:10010000FF4FA591B491FC01E859FF4F859194915F\r\n:100110008FB7F894EC91E22BEC938FBF089590E0A9\r\n:10012000FC01EC55FF4F2491FC01E057FF4F349147\r\n:10013000FC01E458FF4FE491EE23C9F0222339F08B\r\n:10014000233001F1A8F4213019F1223029F1F0E037\r\n:10015000EE0FFF1FE859FF4FA591B4918FB7F894A8\r\n:10016000EC91611126C030953E233C938FBF0895DA\r\n:100170002730A9F02830C9F0243049F78091800059\r\n:100180008F7D03C08091