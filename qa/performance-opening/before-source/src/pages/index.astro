---
import MotionHead from '../components/motion/MotionHead.astro';
import ModoSplash from '../components/motion/ModoSplash.astro';
import App from '../components/App';
import '../styles/global.css';
import '../styles/canvas.css';
import '../styles/learning.css';
import '../styles/diagram-layout.css';
import '../styles/simulation.css';
import '../styles/cable-color.css';
import '../styles/mobile.css';
import '../styles/board-layout.css';
import '../styles/modo-brand.css';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#F7F8FA" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/brand/modo-app-oscuro.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="modo." />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="description" content="modo. · Práctica virtual con cables banana, diagrama y guía revisable. Simulación virtual de mando de 24 V." />
    <meta name="panellab-version" content="2.0" />
    <meta name="modo-version" content="1.0" />
    <link rel="icon" href="/brand/favicon.ico" sizes="any" />
    <title>modo. — Tu espacio de trabajo</title>
    <link rel="preload" as="font" type="font/woff2" href="/fonts/InterVariable.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/SourceSans3-Regular.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/SourceSans3-Semibold.woff2" crossorigin />
  <MotionHead/></head>
  <body><ModoSplash/><App client:load />
    <script>
      if ('serviceWorker' in navigator && import.meta.env.PROD) {
        window.addEventListener('load', () => { navigator.serviceWorker.register('/sw.js').catch(() => {}); });
      }
    </script>
  </body>
</html>
