                "region": {
                  "x": 382,
                  "y": 38,
                  "w": 337,
                  "h": 508
                },
                "explanation": "Al disparar el térmico, 97–98 cierra y enciende el piloto 3 (amarillo).",
                "review": "user_reviewed"
              },
              {
                "id": "simple-14",
                "title": "Fuerza: R a KM1",
                "from": "FUENTE:R",
                "to": "CONTACTOR_TERMICO:L1",
                "region": {
                  "x": 23,
                  "y": 79,
                  "w": 237,
