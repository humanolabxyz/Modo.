            "steps": [
              {
                "id": "simple-01",
                "title": "Fase al mando por el térmico",
                "from": "FUENTE:F",
                "to": "CONTACTOR_TERMICO:95",
                "region": {
                  "x": 32,
                  "y": 79,
                  "w": 308,
                  "h": 566
                },
                "explanation": "La fase F entra al mando pasando por el contacto 95–96 del relé térmico, que es NC. Si el térmico dispara, este contacto abre y corta todo el mando.",
                "review": "user_reviewed"
              },
              {
                "id": "simple-02",
                "title": "Fase hacia el aviso de reposo",
                "from": "CONTACTOR_TERMICO:96",
                "to": "CONTACTOR_TERMICO:71",
                "region": {
                  "x": 32,
                  "y": 427,
                  "w": 162,
                  "h": 218
                },
                "explanation": "Desde 96 (hay fase mientras el térmico esté sano) se alimenta el contacto NC 71–72 de KM1. Cuando KM1 esté en reposo, ese contacto estará cerrado.",
                "review": "user_reviewed"
              },
              {
                "id": "simple-03",
                "title": "Lámpara de reposo (P2)",
                "from": "CONTACTOR_TERMICO:72",
                "to": "BOTONERAS:PILOTO_2",
                "region": {
                  "x": 90,
                  "y": 38,
                  "w": 503,
                  "h": 499
                },
                "explanation": "El piloto 2 (rojo) se enciende solo con KM1 en reposo: la fase llega por 71–72, que está cerrado. Cuando KM1 entra, 71–72 abre y P2 se apaga.",
                "review": "user_reviewed"
              },
              {
                "id": "simple-04",
                "title": "Neutro para las lámparas",
                "from": "BOTONERAS:N",
                "to": "FUENTE:N",
                "region": {
                  "x": 182,
                  "y": 56,
                  "w": 787,
                  "h": 133
                },
                "explanation": "Los pilotos retornan por el borne N de las botoneras; únelo al neutro de la fuente para cerrar sus circuitos.",
                "review": "user_reviewed"
              },
              {
                "id": "simple-05",
                "title": "Del térmico al paro (S2)",
                "from": "CONTACTOR_TERMICO:96",
                "to": "BOTONERAS:S2:1",
                "region": {
                  "x": 90,
                  "y": 123,
                  "w": 591,
                  "h": 521
                },
                "explanation": "Desde 96 la fase va al pulsador rojo S2. Su contacto 1–2 es NC: el mando queda alimentado mientras no pulses el paro.",
                "review": "user_reviewed"
              },
              {
                "id": "simple-06",
                "title": "Del paro a la marcha (S1)",
                "from": "BOTONERAS:S2:2",
                "to": "BOTONERAS:S1:3",
                "region": {
                  "x": 419,
                  "y": 123,
                  "w": 262,
                  "h": 160
                },
                "explanation": "S2:2 es el punto «protegido por el paro»: todo lo que sale de aquí se apaga al pulsar S2. Llévalo al borne 3 de S1 (verde izquierdo), contacto NA 3–4.",
                "review": "user_reviewed"
              },
              {
                "id": "simple-07",
                "title": "A la bobina de KM1",
                "from": "BOTONERAS:S1:4",
                "to": "CONTACTOR_TERMICO:A1",
                "region": {
                  "x": 23,
                  "y": 172,
                  "w": 499,
                  "h": 298
                },
                "explanation": "Al pulsar S1 la fase sale por el borne 4 y llega a A1, el borne de la bobina de KM1.",
                "review": "user_reviewed"
              },
              {
                "id": "simple-08",
                "title": "Retorno de la bobina",
                "from": "CONTACTOR_TERMICO:A2",
                "to": "FUENTE:N",
                "region": {
                  "x": 23,
                  "y": 79,
                  "w": 262,
                  "h": 343
                },
                "explanation": "A2 va al neutro N: la bobina de 24 V CA queda entre la fase (A1) y el neutro (A2). Con S1 pulsado, KM1 ya debería entrar.",
                "review": "user_reviewed"
              },
              {
                "id": "simple-09",
                "title": "Retención: entrada",
                "from": "BOTONERAS:S2:2",
                "to": "CONTACTOR_TERMICO:13",
                "region": {
                  "x": 323,
                  "y": 172,
                  "w": 357,
                  "h": 303
                },
                "explanation": "El contacto auxiliar NA 13–14 de KM1 hace de memoria. Su entrada 13 recibe la fase desde S2:2, después del paro.",
                "review": "user_reviewed"
              },
              {
                "id": "simple-10",
                "title": "Retención: salida en paralelo con S1",
                "from": "CONTACTOR_TERMICO:14",
                "to": "BOTONERAS:S1:4",
                "region": {
                  "x": 382,
                  "y": 172,
                  "w": 141,
                  "h": 303
                },
                "explanation": "14 devuelve la fase a S1:4, en paralelo con el pulsador. Cuando KM1 entra, 13–14 cierra y mantiene la bobina aunque sueltes S1; solo el paro la suelta.",
                "review": "user_reviewed"
              },
              {
                "id": "simple-11",
                "title": "Lámpara de KM1 (P1)",
                "from": "CONTACTOR_TERMICO:A1",
                "to": "BOTONERAS:PILOTO_1",
                "region": {
                  "x": 23,
                  "y": 38,
                  "w": 445,
                  "h": 432
                },
                "explanation": "El piloto 1 toma la fase del mismo punto que la bobina: se enciende cuando KM1 está activo.",
                "review": "user_reviewed"
              },
              {
                "id": "simple-12",
                "title": "Fase al aviso de térmico disparado",
                "from": "FUENTE:F",
                "to": "CONTACTOR_TERMICO:97",
                "region": {
                  "x": 236,
                  "y": 79,
                  "w": 191,
                  "h": 468
                },
                "explanation": "El contacto 97–98 de KM1 es NA: cierra cuando el relé térmico dispara. Alimenta 97 con la fase.",
                "review": "user_reviewed"
              },
              {
                "id": "simple-13",
                "title": "Lámpara de térmico disparado (P3)",
                "from": "CONTACTOR_TERMICO:98",
