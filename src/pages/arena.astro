---
import ArenaApp from '../robotics/arena/ArenaApp';
import Compat from '../components/Compat.astro';
import OfflineRegistration from '../components/OfflineRegistration.astro';
import '../styles/modo-brand.css';
import '../styles/modo-identity.css';
---
<!doctype html><html lang="es"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"/><meta name="theme-color" content="#0a1425"/><title>Arena de robots · modo.</title><meta name="description" content="Construye en el taller y enfrenta tus robots en la arena de sumo."/><meta name="robots" content="noindex,nofollow"/><link rel="icon" href="/brand/modo-app-oscuro.svg" type="image/svg+xml"/><link rel="manifest" href="/manifest.webmanifest"/><link rel="preload" as="font" type="font/woff2" href="/fonts/SourceSans3-Regular.woff2" crossorigin/><Compat/><OfflineRegistration/></head><body class="modo-identity"><ArenaApp client:only="react"><div slot="fallback" class="arena-loading">Preparando la arena…</div></ArenaApp></body></html>
<style is:global>@view-transition{navigation:none}body{margin:0;overflow:hidden;background:#0a1425}.arena-loading{height:100dvh;display:grid;place-items:center;color:#d4e3fb;font:600 18px system-ui}</style>
