---
import MotionHead from '../components/motion/MotionHead.astro';
import ModoSplash from '../components/motion/ModoSplash.astro';
import RoboticsApp from '../robotics/RoboticsApp';
import '../styles/modo-brand.css';
import '../styles/touch-portrait.css';
import '../styles/modo-soft-ui.css';
import '../styles/modo-identity.css';
---
<!doctype html>
<html lang="es"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/><meta name="theme-color" content="#e6e7e8"/><link rel="apple-touch-icon" href="/brand/apple-touch-icon.png"/><link rel="icon" href="/brand/modo-app-oscuro.svg" type="image/svg+xml"/><link rel="manifest" href="/manifest.webmanifest"/><meta name="apple-mobile-web-app-capable" content="yes"/><meta name="mobile-web-app-capable" content="yes"/><meta name="apple-mobile-web-app-title" content="modo."/><meta name="apple-mobile-web-app-status-bar-style" content="default"/><title>Robótica · modo.</title><meta name="description" content="Diseña, programa y simula robots Arduino en una pizarra 3D. Versión Beta."/><link rel="preload" as="font" type="font/woff2" href="/fonts/SourceSans3-Regular.woff2" crossorigin/><link rel="preload" as="font" type="font/woff2" href="/fonts/SourceSans3-Semibold.woff2" crossorigin/><meta name="author" content="Humano Lab · Félix Levancini"/><meta name="robots" content="noindex, nofollow, noarchive"/><MotionHead/></head><body class="modo-soft-ui modo-identity"><ModoSplash/><RoboticsApp client:only="react"><div slot="fallback" class="rb-loading"><span>Abriendo Robótica…</span><small>Si esto tarda: Robótica necesita cargarse una vez con conexión a internet. Conéctate y recarga la página.</small></div></RoboticsApp></body></html>
<style is:global>body{margin:0;overflow:hidden}.rb-loading{position:fixed;inset:0;display:grid;place-content:center;justify-items:center;gap:10px;padding:24px;text-align:center;font:600 15px system-ui,sans-serif;color:#667487;background:#eef1f4}.rb-loading small{max-width:340px;font-weight:400;font-size:13px;line-height:1.45;opacity:0;animation:rb-hint 0s 7s forwards}@keyframes rb-hint{to{opacity:1}}</style>
