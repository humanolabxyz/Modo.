---
import MotionHead from '../components/motion/MotionHead.astro';
import ModoSplash from '../components/motion/ModoSplash.astro';
import AgroApp from '../agro/AgroApp';
import '../styles/modo-brand.css';
import '../styles/touch-portrait.css';
import '../styles/modo-soft-ui.css';
import '../styles/modo-identity.css';
import '../styles/agro.css';
import '../styles/agro-fase2.css';
import '../styles/agro-fase3.css';
import '../styles/agro-fase4.css';
import '../styles/agro-fase5.css';
import '../styles/agro-fase5b.css';
import '../styles/agro-fase6.css';
import '../styles/agro-workflow.css';
---
<!doctype html>
<html lang="es"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/><meta name="theme-color" content="#e6e7e8"/><link rel="apple-touch-icon" href="/brand/apple-touch-icon.png"/><link rel="icon" href="/brand/modo-app-oscuro.svg" type="image/svg+xml"/><link rel="manifest" href="/manifest.webmanifest"/><meta name="apple-mobile-web-app-capable" content="yes"/><meta name="mobile-web-app-capable" content="yes"/><meta name="apple-mobile-web-app-title" content="modo."/><meta name="apple-mobile-web-app-status-bar-style" content="default"/><title>Agro · modo.</title><meta name="description" content="Mundo agrícola 3D: construye, conecta, programa y simula una finca."/><meta name="author" content="Humano Lab · Félix Levancini"/><meta name="robots" content="noindex, nofollow, noarchive"/><MotionHead/></head><body class="modo-soft-ui modo-identity"><ModoSplash/><AgroApp client:only="react"><div slot="fallback" class="agro-loading"><span>Abriendo Agro…</span></div></AgroApp></body></html>
<style is:global>body{margin:0;overflow:hidden}.agro-loading{position:fixed;inset:0;display:grid;place-content:center;font:600 15px system-ui,sans-serif;color:#667487;background:#eef1f4}</style>
